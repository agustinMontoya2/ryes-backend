{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "composite": false,
    "declarationMap": false,
    "incremental": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "coverage",
    "docs",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.mjs"
  ]
}
