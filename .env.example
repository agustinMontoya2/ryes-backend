STAGE=dev
PORT=3000
ACTIVATE_HELMET_SECURITY=false
ACTIVATE_VERSIONING=true
ACTIVATE_CORS=true

SWAGGER_PATH=docs
SWAGGER_DOCS_TITLE=Branches API
SWAGGER_DOCS_DESCRIPTION=api-documentation-for-development
SWAGGER_DOCS_VERSION=1.0

DB_NAME=branches_db
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
